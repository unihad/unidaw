#!/usr/bin/env bash
# Laedt die ML-Modelle von unidaw aus ihrer Quelle (unidaw liefert keine Modelle
# mit, docs/lizenzen-agpl.md). Jedes Modell behaelt seine eigene Lizenz; das
# Skript nennt sie vor dem Download und prueft jede Datei per SHA-256.
#
#   unidaw-fetch-models [<ordner>]
#
# Ordner: Standard ${XDG_DATA_HOME:-~/.local/share}/unidaw/models — dort sucht
# unidaw sie, wenn neben der Binary keine liegen (dawd/source/Resources.h).
# tools/fetch_ml.sh ruft es mit dawd/models auf. Vorhandene Dateien bleiben.
set -euo pipefail

dest="${1:-${XDG_DATA_HOME:-$HOME/.local/share}/unidaw/models}"
mkdir -p "$dest"

cat <<'EOF'
unidaw downloads these models from their original source. unidaw does not ship
them; each one keeps its own license:

  basic-pitch (Spotify)            audio to MIDI      Apache-2.0
    https://github.com/spotify/basic-pitch
  HT-Demucs v4, ONNX export        4-stem separation  MIT (model card)
    https://huggingface.co/adowu/htdemucs-onnx
  HT-Demucs 6s, ONNX export        6-stem separation  MIT (model card)
    https://huggingface.co/StemSplitio/htdemucs-6s-onnx
  LAION CLAP larger_clap_general,  sound search       Apache-2.0 (base model card)
    ONNX export by Xenova
    https://huggingface.co/laion/larger_clap_general
    https://huggingface.co/Xenova/larger_clap_general

Size: about 1.2 GB.
EOF
echo "Folder: $dest"

fetch () {   # fetch <ziel> <sha256> <url>
    if [ -s "$dest/$1" ]; then
        echo "$1: already there"
        return
    fi
    echo "$1 …"
    curl -fL --progress-bar -o "$dest/$1.part" "$3"
    if ! echo "$2  $dest/$1.part" | sha256sum -c --quiet -; then
        rm -f "$dest/$1.part"
        echo "unidaw-fetch-models: $1 does not match the checked file (SHA-256) — not saved" >&2
        exit 1
    fi
    mv "$dest/$1.part" "$dest/$1"
}

# Pruefsummen: Stand der Lizenzpruefung 2026-11-19 (docs/lizenzen-agpl.md)
# basic-pitch: polyphone Noten-Erkennung, 22,05 kHz
fetch basic-pitch.onnx 2c3c1d144bfa61ad236e92e169c13535c880469a12a047d4e73451f2c059a0ec \
    "https://github.com/spotify/basic-pitch/raw/main/basic_pitch/saved_models/icassp_2022/nmp.onnx"
# HT-Demucs v4 (Meta, Export adowu, fp32, ~316 MB): Stems drums/bass/other/
# vocals, Stereo 44,1 kHz, 7,8-s-Segmente
fetch htdemucs.onnx 68d0bf16428ef66e692cdff8a9ccf28f1ef3f69440d57e58605a4cc55fcc5e74 \
    "https://huggingface.co/adowu/htdemucs-onnx/resolve/main/htdemucs.onnx"
# HT-Demucs 6s (Export StemSplit, fp32, ~258 MB): dazu guitar/piano, gleiche
# Schnittstelle (separateStems stems 6)
fetch htdemucs_6s.onnx 48f8e84945579f8ab340e083339e9221e03785dbe733a52c388200b6d3ca779a \
    "https://huggingface.co/StemSplitio/htdemucs-6s-onnx/resolve/main/htdemucs_6s.onnx"
# CLAP: Audio-Encoder int8 (gleiche Treffer wie fp32), Text-Encoder fp32
# (int8 verschiebt die Treffer), dazu der RoBERTa-Tokenizer
CLAP="https://huggingface.co/Xenova/larger_clap_general/resolve/main"
fetch clap-audio-q8.onnx 320b831d0043d36aa8cfad0f36b64b7c597fa9ff01a5a9b505e37632923cf9ac "$CLAP/onnx/audio_model_quantized.onnx"
fetch clap-text.onnx 386413c758300d8f2be107b9fefbc049945b1b1b302938b01039af0ad4984595 "$CLAP/onnx/text_model.onnx"
fetch clap-tokenizer.json dc239041d98de27ffc3975473a1a23e3db4c937b23c138c38bbc66588bd247e5 "$CLAP/tokenizer.json"

echo "ok: models in $dest — restart unidaw to use them"
