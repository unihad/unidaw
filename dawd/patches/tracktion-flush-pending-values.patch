+void ExternalPlugin::passPendingValuesToPlugin()
+{
+    TRACKTION_ASSERT_MESSAGE_THREAD
+    auto pi = getAudioPluginInstance();
+
+    // A graph that holds the plugin passes them on in its next block - never process
+    // it from here then. A disabled plugin gets no blocks from a graph either.
+    if (pi == nullptr || ! (valuesPending || numOpenEditors > 0) || ! baseClassNeedsInitialising() || ! isEnabled())
+        return;
+
+    CRASH_TRACER_PLUGIN (getDebugName());
+    const juce::ScopedLock sl (processMutex);
+
+    // Prepared once and left prepared, as a released graph leaves it: a graph that
+    // starts with the same settings does not prepare it again
+    if (! isInstancePrepared)
+    {
+        auto& dm = engine.getDeviceManager();
+        lastSampleRate = dm.getSampleRate();
+        lastBlockSizeSamples = dm.getBlockSize();
+        pi->prepareToPlay (lastSampleRate, lastBlockSizeSamples);
+        isInstancePrepared = true;
+    }
+
+    // One sample of silence: some plugins (e.g. VST3s) skip a block of 0 samples
+    juce::AudioBuffer<float> buffer (std::max (1, std::max (pi->getTotalNumInputChannels(), pi->getTotalNumOutputChannels())), 1);
+    buffer.clear();
+    juce::MidiBuffer midi;
+    pi->processBlock (buffer, midi);
+
+    // Values the plugin reported in this block came from it, not for it
+    valuesPending = false;
+}
