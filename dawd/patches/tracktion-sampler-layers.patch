+// Starts the sounds a note-on triggers: those whose keys and velocity range
+// match, of each round-robin group the next in turn; a sound in a choke group
+// stops the notes of that group that were already playing
+void SamplerPlugin::startNote (int note, int velocity, float gain, int sampleDelay, bool highlight)
+{
+    auto plays = [&] (const SamplerSound* ss)
+    {
+        return ss->minNote <= note && ss->maxNote >= note
+            && ss->minVelocity <= velocity && ss->maxVelocity >= velocity
+            && ss->audioData.getNumSamples() > 0 && ! ss->audioFile.isNull();
+    };
+
+    const int playingBefore = playingNotes.size();
+    juce::BigInteger groupsDone;
+
+    for (auto ss : soundList)
+    {
+        if (! plays (ss) || playingNotes.size() >= maximumSimultaneousNotes)
+            continue;
+
+        auto chosen = ss;
+
+        if (const int group = ss->roundRobinGroup; group > 0)
+        {
+            if (groupsDone[group])
+                continue;
+
+            groupsDone.setBit (group);
+            int num = 0;
+
+            for (auto o : soundList)
+                if (o->roundRobinGroup == group && plays (o))
+                    ++num;
+
+            int k = nextRoundRobin[group] % num;
+            nextRoundRobin[group] = k + 1;
+
+            for (auto o : soundList)
+                if (o->roundRobinGroup == group && plays (o) && k-- == 0)
+                    { chosen = o; break; }
+        }
+
+        if (chosen->chokeGroup > 0)
+            for (int i = 0; i < playingBefore; ++i)
+                if (playingNotes.getUnchecked (i)->chokeGroup == chosen->chokeGroup)
+                    playingNotes.getUnchecked (i)->choke (sampleDelay);
+
+        if (highlight)
+            highlightedNotes.setBit (note);
+
+        auto sn = new SampledNote (note,
+                                   chosen->keyNote,
+                                   gain,
+                                   chosen->audioFile,
+                                   sampleRate,
+                                   sampleDelay,
+                                   chosen->audioData,
+                                   chosen->fileLengthSamples,
+                                   chosen->gainDb,
+                                   chosen->pan,
+                                   chosen->openEnded);
+        sn->chokeGroup = chosen->chokeGroup;
+        sn->setEnvelope (chosen->attack, chosen->release, sampleRate);
+        playingNotes.add (sn);
+    }
+}
