+// Defaults are not stored, so a sound without layers, groups or envelope
+// keeps its state as before
+static void setOrRemove (juce::ValueTree v, const juce::Identifier& id, const juce::var& value,
+                         const juce::var& defaultValue, juce::UndoManager* um)
+{
+    if (value == defaultValue)
+        v.removeProperty (id, um);
+    else
+        v.setProperty (id, value, um);
+}
+
+int SamplerPlugin::getSoundMinVelocity (int index) const        { return getSound (index).getProperty (SamplerIDs::minVelocity, 1); }
+int SamplerPlugin::getSoundMaxVelocity (int index) const        { return getSound (index).getProperty (SamplerIDs::maxVelocity, 127); }
+int SamplerPlugin::getSoundRoundRobinGroup (int index) const    { return getSound (index)[SamplerIDs::roundRobinGroup]; }
+int SamplerPlugin::getSoundChokeGroup (int index) const         { return getSound (index)[SamplerIDs::chokeGroup]; }
+double SamplerPlugin::getSoundAttack (int index) const          { return getSound (index)[SamplerIDs::attack]; }
+double SamplerPlugin::getSoundRelease (int index) const         { return getSound (index)[SamplerIDs::release]; }
+
+void SamplerPlugin::setSoundVelocityRange (int index, int minVelocity, int maxVelocity)
+{
+    auto um = getUndoManager();
+    auto v = getSound (index);
+    setOrRemove (v, SamplerIDs::minVelocity, juce::jlimit (1, 127, std::min (minVelocity, maxVelocity)), 1, um);
+    setOrRemove (v, SamplerIDs::maxVelocity, juce::jlimit (1, 127, std::max (minVelocity, maxVelocity)), 127, um);
+}
+
+void SamplerPlugin::setSoundGroups (int index, int roundRobinGroup, int chokeGroup)
+{
+    auto um = getUndoManager();
+    auto v = getSound (index);
+    setOrRemove (v, SamplerIDs::roundRobinGroup, juce::jlimit (0, 127, roundRobinGroup), 0, um);
+    setOrRemove (v, SamplerIDs::chokeGroup, juce::jlimit (0, 127, chokeGroup), 0, um);
+}
+
+void SamplerPlugin::setSoundEnvelope (int index, double attackSeconds, double releaseSeconds)
+{
+    auto um = getUndoManager();
+    auto v = getSound (index);
+    setOrRemove (v, SamplerIDs::attack, std::max (0.0, attackSeconds), 0.0, um);
+    setOrRemove (v, SamplerIDs::release, std::max (0.0, releaseSeconds), 0.0, um);
+}
