+bool AutomatableParameter::needsExplicitValueSaved() const
+{
+    // Right after a modifier is removed the current value is back at the explicit
+    // one, but the attached value can still hold a modified value until its async
+    // update: a state saved then would load that as the explicit value
+    return getCurrentValue() != getCurrentExplicitValue()
+        || (attachedValue != nullptr && attachedValue->getValue() != getCurrentExplicitValue());
+}
