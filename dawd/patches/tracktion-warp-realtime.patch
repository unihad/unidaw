+//==============================================================================
+// Real-time warp: one time-stretcher plays the source file through a WarpMap.
+// The TimeRangeReader maps each block's warp-time range to source time (so the
+// read position stays locked to the map), the TimeStretchReader sets the
+// stretcher's ratio per fed chunk from the map at the source position the
+// stretcher is about to process. Changing the ratio per output block instead
+// lands transients up to ~7 ms off, because audio already buffered in the
+// stretcher is then stretched with the new ratio. Before the first and after
+// the last marker the source plays at speed 1.
+namespace realtime_warp
+{
+    inline TimePosition warpToSource (const WarpMap& map, TimePosition warp)
+    {
+        if (map.empty())
+            return warp;
+
+        if (warp <= map.front().warpTime)
+            return map.front().sourceTime + (warp - map.front().warpTime);
+
+        for (size_t i = 1; i < map.size(); ++i)
+        {
+            if (warp <= map[i].warpTime)
+            {
+                const auto span = map[i].warpTime - map[i - 1].warpTime;
+
+                if (span <= 0s)
+                    return map[i].sourceTime;
+
+                return map[i - 1].sourceTime + (map[i].sourceTime - map[i - 1].sourceTime) * ((warp - map[i - 1].warpTime) / span);
+            }
+        }
+
+        return map.back().sourceTime + (warp - map.back().warpTime);
+    }
+
+    /** Source seconds per warp second at a source position. */
+    inline double sourceSpeedAt (const WarpMap& map, TimePosition source)
+    {
+        for (size_t i = 1; i < map.size(); ++i)
+        {
+            if (source < map[i].sourceTime)
+            {
+                if (source < map[i - 1].sourceTime)
+                    return 1.0;
+
+                const auto warpSpan = map[i].warpTime - map[i - 1].warpTime;
+                return warpSpan > 0s ? (map[i].sourceTime - map[i - 1].sourceTime) / warpSpan : 1.0;
+            }
+        }
+
+        return 1.0;
+    }
+
+    /** How far behind the next fed sample the stretcher works on, in samples at the
+        stretcher's rate. Found by measuring click onsets in renders (Rubberband R2,
+        44.1 and 48 kHz sources, 0.7x..1.45x between markers): 384 keeps them
+        within +-4.5 ms, 0 and 768 put them up to 7 ms off. */
+    constexpr SampleCount lookBehindSamples = 384;
+}
